#!/usr/bin/env python3
"""Enumerate every voice of the installed TTS engines into one normalized catalog.

Reads each engine's own voice list and writes a JSON file the Neovim module
loads. Nothing is curated: every discoverable voice becomes one entry, keyed by
language. Engine-specific knobs (rate/pitch for edge, length_scale for Piper,
speed for Kokoro, variant/speed/pitch for espeak) live in per-entry `settings`
so a voice is a *voice*, not a pile of near-duplicate rows.

Usage: tts-build-voices [--out FILE] [--piper-voices FILE]
"""
import argparse, json, os, re, subprocess, sys, datetime, collections

HOME = os.path.expanduser("~")
DEFAULT_OUT = f"{HOME}/.local/share/nvim/tts-voices.json"
KOKORO_BIN = f"{HOME}/.local/share/nvim/kokoro/voices-v1.0.bin"
KOKORO_ALT = "/tmp/opencode/tts/kokoro/voices-v1.0.bin"

REGIONS = {
    "US": "United States", "GB": "United Kingdom", "AU": "Australia", "CA": "Canada",
    "IE": "Ireland", "IN": "India", "NZ": "New Zealand", "ZA": "South Africa",
    "NG": "Nigeria", "KE": "Kenya", "TZ": "Tanzania", "PH": "Philippines",
    "SG": "Singapore", "HK": "Hong Kong", "029": "Caribbean",
    "FR": "France", "BE": "Belgium", "CH": "Switzerland",
    "ES": "Spain", "MX": "Mexico", "AR": "Argentina", "BO": "Bolivia", "CL": "Chile",
    "CO": "Colombia", "CR": "Costa Rica", "CU": "Cuba", "DO": "Dominican Republic",
    "EC": "Ecuador", "GQ": "Equatorial Guinea", "GT": "Guatemala", "HN": "Honduras",
    "NI": "Nicaragua", "PA": "Panama", "PE": "Peru", "PR": "Puerto Rico",
    "PY": "Paraguay", "SV": "El Salvador", "UY": "Uruguay", "VE": "Venezuela",
    "419": "Latin America", "BR": "Brazil", "PT": "Portugal",
    "DE": "Germany", "AT": "Austria", "NL": "Netherlands", "IT": "Italy",
    "PL": "Poland", "RU": "Russia", "SE": "Sweden", "NO": "Norway", "DK": "Denmark",
    "FI": "Finland", "GR": "Greece", "TR": "Türkiye", "SA": "Saudi Arabia",
    "EG": "Egypt", "AE": "United Arab Emirates", "IL": "Israel", "IR": "Iran",
    "CN": "China", "TW": "Taiwan", "JP": "Japan", "KR": "Korea", "TH": "Thailand",
    "VN": "Vietnam", "ID": "Indonesia", "MY": "Malaysia", "UA": "Ukraine",
    "CZ": "Czechia", "HU": "Hungary", "RO": "Romania", "BG": "Bulgaria",
    "HR": "Croatia", "SK": "Slovakia", "SI": "Slovenia", "RS": "Serbia",
    "LT": "Lithuania", "LV": "Latvia", "EE": "Estonia", "IS": "Iceland",
    "MT": "Malta", "CY": "Cyprus", "LU": "Luxembourg",
}

# espeak bare voice name -> English language name (used when a locale has no name)
ESPEAK_NAME = {}


def accent_of(locale):
    """Human accent label from a locale code (fr-CA -> Canada)."""
    parts = locale.replace("_", "-").split("-")
    if len(parts) >= 3:
        tail = "-".join(parts[2:])
        if len(parts) == 3 and parts[2].islower():
            return parts[2].capitalize()
        return tail
    if len(parts) == 2:
        return REGIONS.get(parts[1], parts[1])
    return "generic"


def run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=60).stdout
    except Exception as e:
        print(f"! {cmd[0]}: {e}", file=sys.stderr)
        return ""


# ---------------------------------------------------------------- edge-tts
def parse_edge():
    out = run(["edge-tts", "--list-voices"])
    dialect = re.compile(r"^([a-z]{2,3}-[A-Za-z0-9]{2,4})-([a-z][a-z0-9]*)-(.+?)Neural\s+(Male|Female)\b")
    plain = re.compile(r"^([a-z]{2,3}-[A-Za-z0-9]{2,4})-(.+?)Neural\s+(Male|Female)\b")
    res = []
    for line in out.splitlines():
        m = dialect.match(line)
        if m:
            loc, name, g = f"{m.group(1)}-{m.group(2)}", m.group(3), m.group(4)[0]
        else:
            m = plain.match(line)
            if not m:
                continue
            loc, name, g = m.group(1), m.group(2), m.group(3)[0]
        name = re.sub(r"Multilingual$", "", name)
        res.append({
            "id": f"edge:{loc}-{name}Neural", "provider": "edge-tts",
            "engine_voice": f"{loc}-{name}Neural", "name": name, "locale": loc,
            "accent": accent_of(loc), "gender": g,
            "settings": {"rate": "+0%", "pitch": "+0Hz", "volume": "+0%"},
        })
    return res


# ---------------------------------------------------------------- piper
def parse_piper(listing):
    res = []
    for line in listing.splitlines():
        line = line.strip()
        if not line or "-" not in line:
            continue
        loc = line.split("-", 1)[0]
        rest = line.split("-", 1)[1]
        name, _, tier = rest.rpartition("-")
        res.append({
            "id": f"piper:{line}", "provider": "piper", "engine_voice": line,
            "name": name or rest, "locale": loc.replace("_", "-"),
            "accent": accent_of(loc), "gender": "", "quality": tier or "",
            "settings": {"length_scale": 1.0, "sentence_silence": 0.0},
        })
    return res


# ---------------------------------------------------------------- espeak-ng
def parse_espeak():
    out = run(["espeak-ng", "--voices"])
    res = []
    for line in out.splitlines():
        p = line.split()
        if len(p) < 4 or not p[0].isdigit():
            continue
        code, ag, name = p[1], p[2], p[3]
        g = ag.rsplit("/", 1)[-1][:1]
        if g not in ("M", "F"):
            g = ""
        locale = code
        if "-" in code:
            head = code.split("-")
            if len(head) >= 2 and len(head[1]) == 2:
                head[1] = head[1].upper()
            locale = "-".join(head)
        res.append({
            "id": f"espeak:{code}", "provider": "espeak-ng", "engine_voice": code,
            "name": name.replace("_", " "), "locale": locale,
            "accent": accent_of(locale), "gender": g,
            "settings": {"variant": "", "speed": 175, "pitch": 50, "gap": 5,
                         "amplitude": 100, "punct": False},
        })
        if "-" not in code:
            ESPEAK_NAME.setdefault(code, name.replace("_", " "))
    return res


# ---------------------------------------------------------------- kokoro
KOK = {"a": "en-US", "b": "en-GB", "e": "es-ES", "f": "fr-FR", "h": "hi-IN",
       "i": "it-IT", "j": "ja-JP", "p": "pt-BR", "z": "zh-CN"}
KOK_G = {"f": "F", "m": "M"}


def parse_kokoro():
    path = KOKORO_BIN if os.path.exists(KOKORO_BIN) else KOKORO_ALT
    if not os.path.exists(path):
        print(f"! kokoro: {path} not found", file=sys.stderr)
        return []
    try:
        import numpy as np
        keys = list(np.load(path).keys())
    except Exception as e:
        print(f"! kokoro: {e}", file=sys.stderr)
        return []
    res = []
    for k in keys:
        loc, _, nm = k.partition("_")
        res.append({
            "id": f"kokoro:{k}", "provider": "kokoro", "engine_voice": k,
            "name": nm, "locale": KOK.get(loc[0], loc), "accent": accent_of(KOK.get(loc[0], loc)),
            "gender": KOK_G.get(loc[1], ""),
            "settings": {"speed": 1.0},
        })
    return res


MANUAL = {"en": "English", "fr": "French", "gl": "Galician", "mn": "Mongolian",
          "no": "Norwegian", "zh": "Chinese", "fil": "Filipino", "iu": "Inuktitut",
          "jv": "Javanese", "km": "Khmer", "lo": "Lao", "ps": "Pashto",
          "so": "Somali", "su": "Sundanese", "zu": "Zulu", "yue": "Cantonese"}


def lang_name(base):
    n = ESPEAK_NAME.get(base) or MANUAL.get(base) or base.upper()
    return re.sub(r"\s*\(.*\)$", "", n)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--out", default=DEFAULT_OUT)
    ap.add_argument("--piper-voices", default=None,
                    help="file with `python3 -m piper.download_voices` output")
    args = ap.parse_args()

    if args.piper_voices:
        listing = open(args.piper_voices).read()
    elif os.path.exists("/tmp/opencode/piper_voices.txt"):
        listing = open("/tmp/opencode/piper_voices.txt").read()
    else:
        listing = run([sys.executable, "-m", "piper.download_voices"])

    voices = parse_edge() + parse_piper(listing) + parse_espeak() + parse_kokoro()

    langs = collections.defaultdict(list)
    for v in voices:
        langs[v["locale"].split("-")[0]].append(v)

    doc = {
        "generated": datetime.datetime.now().isoformat(timespec="seconds"),
        "providers": {
            "edge-tts": {"kind": "cloud", "offline": False},
            "piper": {"kind": "local", "offline": True},
            "kokoro": {"kind": "local", "offline": True},
            "espeak-ng": {"kind": "local", "offline": True},
        },
        "languages": {b: {"name": lang_name(b), "voices": vs} for b, vs in sorted(langs.items())},
    }
    os.makedirs(os.path.dirname(args.out), exist_ok=True)
    with open(args.out, "w") as f:
        json.dump(doc, f, ensure_ascii=False, indent=1)

    per = collections.Counter(v["provider"] for v in voices)
    print(f"wrote {args.out}")
    print(f"  voices: {len(voices)}   languages: {len(langs)}")
    for p, c in sorted(per.items()):
        print(f"    {p:10s} {c}")
    fr = langs.get("fr", [])
    print(f"  fr: {len(fr)} voices")
    for v in fr:
        print(f"    {v['provider']:9s} {v['locale']:6s} {v['name']:16s} "
              f"{v['gender']:1s} {v['accent']}")


if __name__ == "__main__":
    main()
