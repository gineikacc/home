#Blacklist everything
/*
.config/*
.config/nvim/*
/.config/ghostty/*
/.config/awesome/*
/.config/alacritty/*
/.config/alacritty/themes/*
/.config/alacritty/themes/themes/*

#Whitelist the following
!/.gitignore
!/.bash_profile
!/.bashrc
!/.clang-format
!/.emacs
!/.tmux.conf
!/.xinitrc


!/.config/
!/.config/nvim/
!/.config/nvim/init.lua
!/.config/nvim/lua/
!/.config/nvim/after/
!/.config/ghostty/
!/.config/ghostty/config
!/.config/awesome/
!/.config/awesome/rc.lua
!/.config/alacritty/
!/.config/alacritty/alacritty.toml
!/.config/alacritty/themes/
!/.config/alacritty/themes/themes/
!/.config/alacritty/themes/themes/gineikacc.toml
!/.config/rofi/
!/.config/gtk-3.0/settings.ini
!/.config/gtk-4.0/
!/.config/gtk-4.0/*

# ~/.local/bin helpers used by the Neovim TTS module (tts_synth/tts_pool).
# The parent dirs must be un-ignored first (git cannot re-include past an
# excluded directory); /.local/* then keeps share/ (models, ~11 GB) and state/
# ignored while exposing only these scripts.
!/.local/
/.local/*
!/.local/bin/
/.local/bin/*
!/.local/bin/tts-serve
!/.local/bin/piper-download-all
!/.local/bin/kokoro-tts
!/.local/bin/tts-build-voices



#!/.config/




